# This project reads configuration from ASP.NET Core's standard configuration
# system (appsettings.json, environment variables, user-secrets). This file
# documents the environment variables used in production deployments and local
# development. It is NOT loaded automatically by .NET; set these as real
# environment variables (or user-secrets locally) -- see docs/ADMIN_PROVISIONING.md
# and docs/DEPLOYMENT.md.

# ---- Database ----
# "Sqlite" for local development, "SqlServer" for production.
DatabaseProvider=Sqlite
ConnectionStrings__Sqlite=Data Source=vedansh.db
ConnectionStrings__SqlServer=Server=tcp:your-server.database.windows.net,1433;Database=VedanshSoftware;User ID=...;Password=...;Encrypt=True;

# ---- JWT ----
# Generate a long random string (32+ bytes). Never commit a real value.
Jwt__Secret=
Jwt__Issuer=VedanshSoftwareServices
Jwt__Audience=VedanshSoftwareServicesAdmin
Jwt__ExpiryMinutes=120

# ---- CORS ----
# Comma-is-not-valid-here; ASP.NET Core array binding uses indexed keys,
# e.g. Cors__AllowedOrigins__0, Cors__AllowedOrigins__1
Cors__AllowedOrigins__0=https://www.vedanshsoftware.com

# ---- Email (Gmail SMTP) ----
Email__Enabled=false
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=vedanshsoft@gmail.com
# Generate an App Password from Google Account > Security > App Passwords.
# Never use the actual Gmail account password here.
Email__SmtpPassword=
Email__FromAddress=vedanshsoft@gmail.com
Email__FromName=Vedansh Software Services
Email__OwnerNotificationAddress=vedanshsoft@gmail.com

# ---- Initial admin provisioning (first deploy only, then remove) ----
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
